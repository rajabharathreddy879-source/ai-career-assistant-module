{
  "version": 2,
  "buildCommand": "pnpm --filter @workspace/career-chat run build",
  "outputDirectory": "artifacts/career-chat/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://YOUR-RENDER-BACKEND-URL.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
